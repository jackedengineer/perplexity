# Use a dedicated NON-PRODUCTION Neon project. Never commit real values.
DATABASE_URL=
DATABASE_URL_DIRECT=
# Neon URLs must use sslmode=verify-full; pooled runtime URL, direct owner URL.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# T05 internal admission only. Set before enabling a future guarded submit route.
# Independently generate 32 random bytes as 64 lowercase hex characters per key.
# Retain historical keys while their run intents exist; no default secret is used.
RUN_HMAC_ACTIVE_KEY_ID=
RUN_HMAC_KEYS_JSON=
# Optional deployment spend namespace; requires separately provisioned operator buckets.
RUN_OPERATOR_BUDGET_KEY=research
# T06 semantic input classification. All three required; no model/key defaults.
# Choose an evaluated model and its explicit structured-output/ZDR provider slug.
OPENROUTER_API_KEY=
MODEL_SAFETY=
SAFETY_OPENROUTER_PROVIDER=
# T07 internal retrieval; configure only after reviewing provider privacy/spend controls.
TAVILY_API_KEY=
# T08 private drafting; an explicitly evaluated model and provider, no defaults.
MODEL_ANSWER=
ANSWER_OPENROUTER_PROVIDER=

# T18 authenticated daily recovery sweep; independent random server secret.
CRON_SECRET=

# Required private query-planning role; configure explicitly after evaluation.
MODEL_PLANNER=
PLANNER_OPENROUTER_PROVIDER=

# Guest trials stay off until abuse, provider quality and public-launch gates pass.
ENABLE_GUEST_TRIALS=false
# Evaluated economy catalog keys only; empty disables economy choices.
ENABLED_ANSWER_MODELS=
# Required on public hosts before guest sign-in is displayed or accepted.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated verified Better Auth user IDs permitted to view /operations.
# Empty by default; never grant operator status based on a browser claim.
OPERATOR_AUTH_SUBJECTS=
