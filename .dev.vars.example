# Local workerd proof only. Real credentials belong in ignored .dev.vars.
NEXTJS_ENV=development
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=isolated-cloudflare-proof-not-a-production-secret
GOOGLE_CLIENT_ID=synthetic.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=synthetic-proof-only
DATABASE_URL=postgresql://localhost/disabled_cloudflare_proof
# Provider and payment calls stay off until separate bounded verification.
OPENROUTER_API_KEY=
TAVILY_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
