{
  "name": "perplex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:motion": "playwright test --config playwright.motion.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "eval:offline": "vitest run tests/integration/evaluation-offline-command.test.ts",
    "eval:score": "vitest run --config vitest.eval.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:verify": "node scripts/verify-db.mjs",
    "test:e2e:neon": "LIVE_NEON_ADMISSION=1 LIVE_NEON_E2E=1 playwright test",
    "test:search:neon": "LIVE_NEON_E2E=1 playwright test --config playwright.search.config.ts",
    "perf:check": "node scripts/measure-performance.mjs",
    "perf:profile": "LIVE_NEON_E2E=1 node scripts/profile-browser.mjs",
    "test:admission:neon": "LIVE_NEON_ADMISSION=1 vitest run --config vitest.neon.config.ts tests/live/admission-neon.test.ts",
    "test:input:neon": "LIVE_NEON_ADMISSION=1 vitest run --config vitest.neon.config.ts tests/live/input-gate-neon.test.ts",
    "test:retrieval:neon": "LIVE_NEON_ADMISSION=1 vitest run --config vitest.neon.config.ts tests/live/retrieval-neon.test.ts",
    "test:budgets:neon": "LIVE_NEON_ADMISSION=1 vitest run --config vitest.neon.config.ts tests/live/budgets-neon.test.ts",
    "test:telemetry:neon": "LIVE_NEON_ADMISSION=1 vitest run --config vitest.neon.config.ts tests/live/telemetry-neon.test.ts",
    "test:telemetry:evidence": "LIVE_TELEMETRY_EVIDENCE=1 vitest run --config vitest.neon.config.ts tests/live/telemetry-evidence.test.ts",
    "test:recovery:neon": "LIVE_NEON_ADMISSION=1 vitest run --config vitest.neon.config.ts tests/live/recovery-neon.test.ts",
    "test:completion:neon": "LIVE_NEON_ADMISSION=1 vitest run --config vitest.neon.config.ts tests/live/completion-neon.test.ts",
    "jobs:worker": "tsx scripts/jobs-worker.ts",
    "jobs:dev": "node tools/trigger-cli/node_modules/trigger.dev/dist/esm/index.js dev start --env-file .env.jobs.local --max-concurrent-runs 1 --skip-update-check --skip-telemetry",
    "jobs:dispatch": "tsx scripts/jobs-dispatch.ts",
    "cf:build": "opennextjs-cloudflare build && node scripts/verify-cloudflare-static-cache.mjs && opennextjs-cloudflare populateCache local",
    "cf:preview": "wrangler dev --local --port 8787"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.152",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@opentelemetry/api": "1.9.0",
    "@trigger.dev/sdk": "4.8.3",
    "ai": "7.0.148",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@opennextjs/cloudflare": "1.20.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24",
    "@types/pg": "^8.23.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  },
  "pnpm": {
    "overrides": {
      "tar@6.2.1": "7.5.22",
      "deepmerge-ts@7.1.5": "8.0.2",
      "zod@4.5.4": "4.6.7",
      "glob@10.3.3": "10.5.0"
    }
  }
}
